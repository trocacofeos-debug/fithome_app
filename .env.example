# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# NUNCA commite o arquivo ".env" (já está no .gitignore).

# Cloudflare R2 (compatível com S3)
R2_ENDPOINT=SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx
R2_BUCKET=treino-em-casa
# URL pública do bucket (domínio customizado ou r2.dev):
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
